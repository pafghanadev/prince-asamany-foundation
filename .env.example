# Paystack (donations) — public key is safe for the browser
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxx
# Paystack secret key — server-side donation verification only
PAYSTACK_SECRET_KEY=sk_test_xxxx
# Resend transactional email (contact & volunteer forms)
RESEND_API_KEY=re_xxxx
# Verified sender email for Resend (must be a verified domain/address)
CONTACT_FROM_EMAIL=hello@example.com

# Optional shared rate-limit store (recommended for production and multiple server instances).
# Without these, per-instance fallback rate limiting keeps the forms working.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set only if your deployment provider overwrites this header at its trusted edge:
# Netlify: x-nf-client-connection-ip | Vercel: x-vercel-forwarded-for | Cloudflare: cf-connecting-ip
CONTACT_TRUSTED_IP_HEADER=

# Google Sheet ID for Upcoming Events CMS (sheet must have 'Anyone with link can view')
NEXT_PUBLIC_GOOGLE_SHEET_EVENTS_ID=
# Optional: Google Form URL for staff to easily post events without touching the spreadsheet
NEXT_PUBLIC_GOOGLE_FORM_EVENTS_URL=
